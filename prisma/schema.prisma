generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schema   = "railway" 
}

enum WorkFormat {
  OFFICE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  INTERNSHIP
  ONE_TIME_TASK
  PART_TIME
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  resumes   Resume[]
}

model Company {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  experiences WorkExperience[]
  createdAt   DateTime         @default(now())
}

model WorkExperience {
  id          String   @id @default(uuid())
  position    String
  startDate   DateTime
  endDate     DateTime?
  description String?
  resumeId    String
  companyId   String
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([resumeId])
  @@index([companyId])
}

// TODO можно ли выносить объявления сущностей по подфайлам для призмы
model Resume {
  id             String         @id @default(uuid())
  title          String
  workFormat     WorkFormat
  employmentType EmploymentType
  phone          String
  email          String
  about          String?        
  experiences    WorkExperience[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  skills         Skill[]
}

